# Cove — Community Netlify Guide Environment Configuration
# Copy to `.env` for local development. Never commit `.env`.

# --- Netlify Web OAuth (Optional — register at https://app.netlify.com/user/applications) ---
NETLIFY_OAUTH_CLIENT_ID=
NETLIFY_OAUTH_CLIENT_SECRET=
NETLIFY_OAUTH_REDIRECT_URI=http://localhost:8971/api/netlify/oauth/callback

# Public origin used for OAuth callbacks & status metadata on production
COVE_PUBLIC_ORIGIN=https://cove-netlify-bot.netlify.app

# Optional: Netlify CLI public OAuth client ID (enables Option 1 CLI login tickets on serverless)
NETLIFY_CLI_OAUTH_CLIENT_ID=

# Optional: Dedicated secret for sealing HttpOnly OAuth session cookies (falls back to NETLIFY_OAUTH_CLIENT_SECRET)
COVE_SESSION_SECRET=

# --- Local-Only Agent Opt-In (NEVER set in netlify.toml or production) ---
# Set to 1 ONLY when running `npm run dev` locally to allow localhost-only CLI providers (agy, hermes, etc.)
COVE_LOCAL_AGENTS=0
COVE_PROVIDER=agy
# AGY_PATH=/usr/local/bin/agy
# COVE_AGY_MODEL=
# COVE_AGY_EFFORT=medium
# ZOTH_BRIDGE_URL=http://127.0.0.1:8102
